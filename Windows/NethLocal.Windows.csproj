<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>NethLocal-Windows-v3.6</AssemblyName>
        <Version>3.6.0</Version>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="QRCoder" Version="1.8.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
        <EmbeddedResource Include="$(WorkerExecutable)" LogicalName="NethLocal.Worker.exe" />
        <EmbeddedResource Include="../ThirdParty/llama.cpp-LICENSE" LogicalName="NethLocal.llama-LICENSE" />
        <EmbeddedResource Include="../ThirdParty/QRCoder-LICENSE" LogicalName="NethLocal.QRCoder-LICENSE" />
    </ItemGroup>
</Project>
