@@ -1022,0 +1023,7 @@ struct llama_model {
+    int32_t neth_partition() const { return params.neth_partition; }
+    bool neth_has_layer(uint32_t il) const {
+        const auto cut = neth_partition();
+        if (cut > 0) return il < static_cast<uint32_t>(cut);
+        if (cut < 0) return il >= static_cast<uint32_t>(-cut);
+        return true;
+    }
